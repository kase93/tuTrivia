<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ResultadoController"
      styleClass="main-container"
      stylesheets="@application.css"
      prefWidth="500" prefHeight="420"
      alignment="CENTER"
      spacing="0">

    <VBox styleClass="panel-juego" alignment="CENTER" spacing="16"
          prefWidth="420">

        <!-- Emoji grande -->
        <Label fx:id="labelEmoji" text="🎉"
               style="-fx-font-size: 64px;" />

        <!-- Título victoria/derrota -->
        <Label fx:id="labelTitulo" text="¡Has ganado!"
               styleClass="titulo" />

        <!-- Puntuación final -->
        <Label fx:id="labelPuntuacion" text="Puntuación: 0"
               styleClass="subtitulo" />

        <!-- Nombre jugador -->
        <Label fx:id="labelJugador" text="Jugador"
               style="-fx-font-size: 14px; -fx-text-fill: #9E9E9E;" />

        <Region prefHeight="10" />
        <Region styleClass="separador" prefWidth="360" />
        <Region prefHeight="10" />

        <Button text="Jugar de nuevo"
                styleClass="boton-menu"
                onAction="#jugarDeNuevo" />

        <Button text="Ver Ranking"
                styleClass="boton-menu"
                onAction="#verRanking" />

        <Button text="← Volver al menú"
                styleClass="boton-salir"
                onAction="#volverAlMenu" />

    </VBox>

</VBox>
