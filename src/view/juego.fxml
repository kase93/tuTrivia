<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.JuegoController"
      styleClass="main-container"
      stylesheets="@application.css"
      prefWidth="640" prefHeight="560"
      alignment="CENTER"
      spacing="0">

    <VBox styleClass="panel-juego" alignment="CENTER" spacing="14"
          prefWidth="560">

        <!-- Barra superior -->
        <HBox alignment="CENTER_LEFT" spacing="0">
            <Label fx:id="labelPuntuacion" text="Puntuación: 0"
                   styleClass="label-puntuacion" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelVidas" text="Vidas: ❤ ❤ ❤"
                   styleClass="label-vidas" />
        </HBox>

        <Region styleClass="separador" prefWidth="500" />

        <!-- Pregunta con altura fija para que no se corte -->
        <Label fx:id="labelPregunta" text="Cargando pregunta..."
               styleClass="label-pregunta"
               prefWidth="500"
               minHeight="80"
               wrapText="true" />

        <!-- Opciones -->
        <Button fx:id="btnOpcion0" text="Opción A"
                styleClass="boton-opcion"
                onAction="#comprobarRespuesta"
                maxWidth="Infinity" />

        <Button fx:id="btnOpcion1" text="Opción B"
                styleClass="boton-opcion"
                onAction="#comprobarRespuesta"
                maxWidth="Infinity" />

        <Button fx:id="btnOpcion2" text="Opción C"
                styleClass="boton-opcion"
                onAction="#comprobarRespuesta"
                maxWidth="Infinity" />

        <Button fx:id="btnOpcion3" text="Opción D"
                styleClass="boton-opcion"
                onAction="#comprobarRespuesta"
                maxWidth="Infinity" />

    </VBox>

</VBox>
